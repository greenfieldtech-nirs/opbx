# ---- Base ----
# NODE_ENV=development
# PORT=8080
# HOST=0.0.0.0

# ---- OPBX connection (required) ----
# Base URL of the OPBX deployment (no trailing slash). The client appends /api/<spec path>.
OPBX_BASE_URL=http://localhost

# Single OPBX REST call timeout (ms)
# OPBX_TIMEOUT_MS=15000

# TTL for cached /auth/me identity resolutions (seconds)
# AUTH_IDENTITY_CACHE_TTL_SECONDS=300

# ---- MCP-side rate limits (requests/min per identity) ----
# RATE_LIMIT_READ_PER_MIN=120
# RATE_LIMIT_WRITE_PER_MIN=30
# RATE_LIMIT_SENSITIVE_PER_MIN=10

# ---- Logging ----
# LOG_LEVEL=info

# ---- OpenTelemetry ----
# When set, traces are exported to <endpoint>/v1/traces (OTLP/HTTP).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=opbx-mcp
