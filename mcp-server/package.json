{
  "name": "opbx-mcp",
  "version": "0.1.0",
  "description": "Semantic MCP facade over the OPBX REST API",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:opbx-client": "node scripts/generate-opbx-client.mjs",
    "validate:opbx-api": "vitest run tests/contract",
    "generate:docs": "tsx scripts/generate-docs.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.68.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "fastify": "^5.6.0",
    "pino": "^9.9.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "openapi-typescript": "^7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.0"
  }
}
