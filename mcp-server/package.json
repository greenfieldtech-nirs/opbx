{
  "name": "opbx-mcp",
  "version": "0.1.0",
  "description": "Semantic MCP facade over the OPBX REST API",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:opbx-client": "node scripts/generate-opbx-client.mjs",
    "validate:opbx-api": "vitest run tests/contract",
    "generate:docs": "tsx scripts/generate-docs.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "openapi-typescript": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "protobufjs": "^8.6.6",
    "js-yaml": "^4.3.2"
  }
}
