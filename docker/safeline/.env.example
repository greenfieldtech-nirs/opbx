# SafeLine WAF (PoC) — copy to docker/safeline/.env and fill in.
# Variables consumed by the vendored official compose.yaml (SafeLine CE v9.4.3).
# Generate the secrets with:
#   for k in MGT_INTERNAL_TOKEN DETECTOR_MGMT_TOKEN; do echo "$k=$(openssl rand -hex 32)"; done
#   echo "DETECTOR_AES_KEY=$(openssl rand -base64 48 | tr -dc A-Za-z0-9 | head -c 16)"
#   echo "POSTGRES_PASSWORD=$(openssl rand -base64 48 | tr -dc A-Za-z0-9 | head -c 24)"

# Host directory for SafeLine state (Postgres data, detector rules, logs).
# Upstream default is /data/safeline; /var/lib is used because /data cannot be
# created on Fedora CoreOS (the Podman machine VM: read-only root).
# Must be a path on the container host (inside the Podman VM on macOS), not a
# macOS bind-share. On SELinux hosts relabel it once:
#   sudo chcon -R -t container_file_t /var/lib/safeline
SAFELINE_DIR=/var/lib/safeline

# Docker Hub images: chaitin/safeline-<svc>${REGION}${ARCH_SUFFIX}:${IMAGE_TAG}
IMAGE_PREFIX=chaitin
IMAGE_TAG=9.4.3
# International edition (English UI). Empty = China edition.
REGION=-g
# "-arm" on aarch64 hosts (Apple Silicon / Graviton), empty on x86_64 (needs SSSE3).
ARCH_SUFFIX=-arm
# chaitin/safeline-postgres-arm:15.18 on aarch64, chaitin/safeline-postgres:15.18 on x86_64.
POSTGRES_IMAGE=chaitin/safeline-postgres-arm:15.18

# Fixed /24 for the safeline-ce bridge; containers get .2 .. .10 on it.
SUBNET_PREFIX=172.22.222

# Alphanumeric only (installer rule).
POSTGRES_PASSWORD=
# 64 hex chars each: mgt<->tengine control channel, and mgt/fvm/luigi -> detector API.
MGT_INTERNAL_TOKEN=
DETECTOR_MGMT_TOKEN=
# 16 alphanumeric chars.
DETECTOR_AES_KEY=
# Optional: outbound proxy for the console's cloud calls (threat intel, updates).
MGT_PROXY=
