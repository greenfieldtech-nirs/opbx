[mysqld]
default-authentication-plugin=mysql_native_password
bind-address=0.0.0.0

# Performance settings for containerized environments
innodb_buffer_pool_size=256M
innodb_log_file_size=64M
max_connections=100

# Enable query cache (deprecated in MySQL 8.0 but useful for compatibility)
query_cache_type=1
query_cache_size=16M
query_cache_limit=1M
