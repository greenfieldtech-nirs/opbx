[mysqld]
default-authentication-plugin=mysql_native_password
bind-address=0.0.0.0

# Performance settings for containerized environments.
# (query_cache_* was removed in MySQL 8.0 and makes the server refuse to start.)
# innodb_log_file_size is intentionally not set: the data dir already has redo logs sized by the defaults.
innodb_buffer_pool_size=256M
max_connections=100

# Log slow queries so DATA-* style regressions are visible
slow_query_log=1
long_query_time=1
