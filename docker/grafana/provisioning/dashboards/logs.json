{
  "uid": "opbx-logs",
  "title": "OPBX Logs",
  "tags": ["opbx", "logs"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "session_token",
        "label": "Session token (audit trail)",
        "type": "textbox",
        "query": "",
        "description": "Cloudonix session token - filters Call Flow Logs to a single call"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Call Flow Logs",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "{log_type=\"call_flow\"} |~ \"$session_token\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "title": "Platform Logs",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 12},
      "targets": [
        {
          "refId": "A",
          "expr": "{log_type=\"platform\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
