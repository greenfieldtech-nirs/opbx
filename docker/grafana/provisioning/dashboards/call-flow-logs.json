{
  "uid": "opbx-logs-call-flow",
  "title": "OPBX Call Flow Logs",
  "tags": [
    "opbx",
    "logs"
  ],
  "timezone": "browser",
  "refresh": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "session_token",
        "label": "Session token (audit trail)",
        "type": "textbox",
        "query": "",
        "description": "Cloudonix session token - filters to a single call"
      },
      {
        "name": "text_search",
        "label": "Text search",
        "type": "textbox",
        "query": "",
        "description": "Free-text filter applied to every log line"
      },
      {
        "name": "line_ts",
        "type": "textbox",
        "query": "none-selected",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log entries - click a row to inspect it",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 24,
        "w": 10,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{log_type=\"call_flow\"} |~ \"$session_token\" |~ \"$text_search\" | regexp \"^(?:\\\\[[^\\\\]]+\\\\] )?(?P<content>\\\\{.*)$\" | line_format \"{{.content}}\"",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "channel": true,
              "extra": true,
              "labels": true,
              "labelTypes": true,
              "id": true,
              "nanos": true,
              "tsNs": true,
              "call_id": true,
              "org_id": true,
              "service": true,
              "level": true
            },
            "indexByName": {
              "Time": 0,
              "session_token": 1,
              "msg": 2
            },
            "renameByName": {
              "msg": "Message",
              "session_token": "Session token"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          },
          "links": [
            {
              "title": "Inspect this entry",
              "url": "/logs/d/opbx-logs-call-flow?${__url_time_range}&var-session_token=${session_token}&var-text_search=${text_search}&var-line_ts=${__data.fields.ts:percentencode}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Message"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Session token"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Selected entry",
      "description": "Parsed content of the entry selected on the left. Empty until a row is clicked.",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 24,
        "w": 14,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{log_type=\"call_flow\"} |~ \"\\\"ts\\\":\\\"$line_ts\\\"\" | regexp \"^(?:\\\\[[^\\\\]]+\\\\] )?(?P<content>\\\\{.*)$\" | line_format \"{{.content}}\"",
          "queryType": "range",
          "maxLines": 5
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": false
          }
        },
        {
          "id": "transpose",
          "options": {}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "schemaVersion": 39,
  "version": 2
}