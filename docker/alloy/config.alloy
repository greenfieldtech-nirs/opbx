// OPBX log collector: tails OPBX containers over the Docker socket and pushes
// to Loki. Containers opt in via the compose label `logging.opbx/collect=true`.
//
// Cardinality rule (see spec): session_token / call_id are STRUCTURED
// METADATA, never labels. Labels stay bounded: service, level, log_type,
// org_id, container.

discovery.docker "opbx" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "opbx" {
	targets = discovery.docker.opbx.targets

	rule {
		source_labels = ["__meta_docker_container_label_logging_opbx_collect"]
		regex        = "true"
		action       = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex        = "/(.*)"
		target_label = "container"
	}
}

loki.source.docker "opbx" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.relabel.opbx.output
	forward_to    = [loki.process.opbx.receiver]
	relabel_rules = discovery.relabel.opbx.rules
	labels        = { job = "opbx" }
}

loki.process "opbx" {
	// Non-JSON lines (boot output, PHP warnings) pass through untouched with
	// only the container label - a failed json stage leaves the entry as-is.
	stage.json {
		expressions = {
			ts            = "ts",
			level         = "level",
			service       = "service",
			log_type      = "log_type",
			org_id        = "org_id",
			session_token = "session_token",
			call_id       = "call_id",
		}
	}

	stage.labels {
		values = {
			service  = "",
			level    = "",
			log_type = "",
			org_id   = "",
		}
	}

	stage.structured_metadata {
		values = {
			session_token = "",
			call_id       = "",
		}
	}

	stage.timestamp {
		source = "ts"
		format = "RFC3339Nano"
	}

	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
