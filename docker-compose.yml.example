version: '3.8'

services:
  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile.dev
    container_name: opbx_frontend
    ports:
      - "${FRONTEND_PORT:-3000}:3000"
    volumes:
      - ./frontend:/app
      - /app/node_modules # Prevent overwriting node_modules
    environment:
      - VITE_API_BASE_URL=/api/v1
      - VITE_API_PROXY_TARGET=http://nginx
      # WebSocket Configuration (must match echo.service.ts variable names)
      # Use nginx proxy (port 80) instead of direct Soketi (port 6001)
      # Nginx proxies /app/ to Soketi internally
      - VITE_PUSHER_APP_KEY=${PUSHER_APP_KEY:-pbxappkey}
      - VITE_PUSHER_APP_CLUSTER=${PUSHER_APP_CLUSTER:-mt1}
      - VITE_WS_HOST=${VITE_WS_HOST:-localhost}
      - VITE_WS_PORT=${VITE_WS_PORT:-80}
      - VITE_WS_SCHEME=${VITE_WS_SCHEME:-http}
      - VITE_ALLOWED_HOSTS=${VITE_ALLOWED_HOSTS:-localhost,.localhost}
    depends_on:
      - app
      - mysql
      - nginx
      - soketi
    networks:
      - opbx
    restart: unless-stopped

  nginx:
    image: nginx:1.27-alpine
    container_name: opbx_nginx
    ports:
      - "${APP_PORT:-80}:80"
    volumes:
      - ./:/var/www/html
      - ./docker/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./docker/nginx/conf.d:/etc/nginx/templates/conf.d:ro
    # Fill the resolver address from the container's own /etc/resolv.conf so the
    # config works under both Docker (127.0.0.11) and Podman (network gateway).
    # The mounted conf.d is read-only, so render into /etc/nginx/conf.d first.
    command:
      - /bin/sh
      - -c
      - |
        set -e
        RESOLVER=$$(awk '/^nameserver/ {print $$2; exit}' /etc/resolv.conf)
        : "$${RESOLVER:?could not determine DNS resolver from /etc/resolv.conf}"
        mkdir -p /etc/nginx/conf.d
        for f in /etc/nginx/templates/conf.d/*.conf; do
          sed "s/__NGINX_RESOLVER__/$${RESOLVER}/g" "$$f" > "/etc/nginx/conf.d/$$(basename "$$f")"
        done
        exec nginx -g 'daemon off;'
    depends_on:
      app:
        condition: service_healthy
    networks:
      - opbx
    restart: unless-stopped

  app:
    build:
      context: .
      dockerfile: docker/php/Dockerfile
    container_name: opbx_app
    labels:
      - "logging.opbx/collect=true"
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M
    volumes:
      - ./:/var/www/html
    environment:
      - OPCACHE_VALIDATE_TIMESTAMPS=${OPCACHE_VALIDATE_TIMESTAMPS:-1}
      # Structured JSON logs to stdout for the optional log stack (alloy/loki).
      - LOG_STACK=${OPBX_LOG_STACK:-single,json}
      - APP_ENV=${APP_ENV:-production}
      - APP_DEBUG=${APP_DEBUG:-false}
      - APP_URL=${APP_URL:-http://localhost}
      - DB_CONNECTION=mysql
      - DB_HOST=mysql
      - DB_DATABASE=${DB_DATABASE:-opbx}
      - DB_USERNAME=${DB_USERNAME:-opbx}
      - DB_PASSWORD=${DB_PASSWORD:-secret}
      - REDIS_HOST=redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-null}
      - MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY:-minioadmin}
      - MINIO_SECRET_KEY=${MINIO_SECRET_KEY:-minioadmin}
      - MINIO_REGION=us-east-1
      - MINIO_BUCKET=recordings
      - MINIO_ENDPOINT=http://minio:9000
      - MINIO_USE_PATH_STYLE=true
      - MCP_PORT=${MCP_PORT:-8080}
      # Auto Dialer Worker authentication (must match DIALER_WORKER_API_TOKEN env var)
      - DIALER_WORKER_API_TOKEN=${DIALER_WORKER_API_TOKEN:-dev-token-change-in-production}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_started
    networks:
      - opbx
    healthcheck:
      test: ["CMD-SHELL", "pgrep php-fpm > /dev/null || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 40s

  queue-worker:
    build:
      context: .
      dockerfile: docker/php/Dockerfile
    container_name: opbx_queue_worker
    labels:
      - "logging.opbx/collect=true"
    deploy:
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M
    command: ["php", "artisan", "queue:work", "redis", "--queue=auto-dialer,default", "--sleep=3", "--tries=3", "--timeout=90"]
    volumes:
      - ./:/var/www/html
    environment:
      - OPCACHE_VALIDATE_TIMESTAMPS=${OPCACHE_VALIDATE_TIMESTAMPS:-1}
      # Structured JSON logs to stdout for the optional log stack (alloy/loki).
      - LOG_STACK=${OPBX_LOG_STACK:-single,json}
      - APP_ENV=${APP_ENV:-production}
      - APP_DEBUG=${APP_DEBUG:-false}
      - DB_CONNECTION=mysql
      - DB_HOST=mysql
      - DB_DATABASE=${DB_DATABASE:-opbx}
      - DB_USERNAME=${DB_USERNAME:-opbx}
      - DB_PASSWORD=${DB_PASSWORD:-secret}
      - REDIS_HOST=redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-null}
      - RUN_MIGRATIONS=false
      # Auto Dialer Worker authentication
      - DIALER_WORKER_API_TOKEN=${DIALER_WORKER_API_TOKEN:-dev-token-change-in-production}
    depends_on:
      - app
      - redis
    networks:
      - opbx
    restart: unless-stopped

  scheduler:
    build:
      context: .
      dockerfile: docker/php/Dockerfile
    container_name: opbx_scheduler
    labels:
      - "logging.opbx/collect=true"
    deploy:
      resources:
        limits:
          memory: 256M
        reservations:
          memory: 128M
    command: /usr/local/bin/scheduler.sh
    volumes:
      - ./:/var/www/html
    environment:
      - OPCACHE_VALIDATE_TIMESTAMPS=${OPCACHE_VALIDATE_TIMESTAMPS:-1}
      # Structured JSON logs to stdout for the optional log stack (alloy/loki).
      - LOG_STACK=${OPBX_LOG_STACK:-single,json}
      - APP_ENV=${APP_ENV:-production}
      - APP_DEBUG=${APP_DEBUG:-false}
      - DB_CONNECTION=mysql
      - DB_HOST=mysql
      - DB_DATABASE=${DB_DATABASE:-opbx}
      - DB_USERNAME=${DB_USERNAME:-opbx}
      - DB_PASSWORD=${DB_PASSWORD:-secret}
      - REDIS_HOST=redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-null}
      - RUN_MIGRATIONS=false
      # Auto Dialer Worker authentication
      - DIALER_WORKER_API_TOKEN=${DIALER_WORKER_API_TOKEN:-dev-token-change-in-production}
    depends_on:
      - app
    networks:
      - opbx
    restart: unless-stopped

  mysql:
    image: mysql:8.0
    container_name: opbx_mysql
    # SECURITY: MySQL port exposure is disabled by default for security
    # Set DB_EXPOSE_PORT in .env to enable external access (not recommended for production)
    # MySQL remains accessible within the Docker network at port 3306
    ports:
      - "${DB_EXPOSE_PORT:-}:3306"
    environment:
      - MYSQL_ROOT_PASSWORD=${DB_ROOT_PASSWORD:-rootsecret}
      - MYSQL_DATABASE=${DB_DATABASE:-opbx}
      - MYSQL_USER=${DB_USERNAME:-opbx}
      - MYSQL_PASSWORD=${DB_PASSWORD:-secret}
    volumes:
      # PERSISTENCE: Bind mount stores MySQL data in ./volumes/mysql on the host.
      # Data survives container restarts, recreation, and even 'docker compose down -v'.
      # The directory is gitignored so it won't be committed.
      # Always backup before major changes: ./scripts/backup-database.sh
      - ./volumes/mysql:/var/lib/mysql
    networks:
      - opbx
    # Restart policy ensures MySQL comes back up after host reboots
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: opbx_redis
    # SECURITY: Redis port exposure is disabled by default for security
    # Set REDIS_EXPOSE_PORT in .env to enable external access (not recommended for production)
    # Redis remains accessible within the Docker network at port 6379
    ports:
      - "${REDIS_EXPOSE_PORT:-}:6379"
    volumes:
      # PERSISTENCE: Bind mount stores Redis data in ./volumes/redis on the host.
      # AOF is enabled so data is written to disk and survives container removal.
      # The directory is gitignored so it won't be committed.
      - ./volumes/redis:/data
    networks:
      - opbx
    command: >
      redis-server
      --appendonly yes
      --requirepass ${REDIS_PASSWORD}
      --bind 0.0.0.0
      --protected-mode yes
    healthcheck:
      test: ["CMD", "sh", "-c", "redis-cli -a ${REDIS_PASSWORD} ping || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5

  minio:
    image: minio/minio:RELEASE.2025-10-15T17-29-55Z
    container_name: opbx_minio
    # SECURITY: MinIO ports are disabled by default for security
    # Set MINIO_EXPOSE_PORT and MINIO_CONSOLE_EXPOSE_PORT in .env to enable external access
    # MinIO remains accessible within the Docker network
    ports:
      - "${MINIO_EXPOSE_PORT:-}:9000"  # MinIO API
      - "${MINIO_CONSOLE_EXPOSE_PORT:-}:9001"  # MinIO Console (Web UI)
    environment:
      MINIO_ROOT_USER: ${MINIO_ACCESS_KEY:-minioadmin}
      MINIO_ROOT_PASSWORD: ${MINIO_SECRET_KEY:-minioadmin}
      MINIO_REGION: ${MINIO_REGION:-us-east-1}
      MINIO_SCANNER: "off"  # Disable scanner to reduce memory usage
    volumes:
      - ./volumes/minio:/data
    networks:
      - opbx
    command: server /data --console-address ":9001"
    deploy:
      resources:
        limits:
          memory: 512M  # Limit memory usage
        reservations:
          memory: 256M  # Reserve minimum memory
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  soketi:
    image: 'quay.io/soketi/soketi:1.6-16-alpine'
    container_name: opbx_websocket
    ports:
      - "${SOKETI_PORT:-6001}:6001"
      - "${SOKETI_METRICS_PORT:-9601}:9601"
    environment:
      SOKETI_DEBUG: '${SOKETI_DEBUG:-0}'
      SOKETI_DEFAULT_APP_ID: '${PUSHER_APP_ID:-app-id}'
      SOKETI_DEFAULT_APP_KEY: '${PUSHER_APP_KEY:-pbxappkey}'
      SOKETI_DEFAULT_APP_SECRET: '${PUSHER_APP_SECRET:-pbxappsecret}'
      SOKETI_METRICS_SERVER_PORT: '9601'
      SOKETI_DEFAULT_APP_ENABLE_CLIENT_MESSAGES: 'false'
      SOKETI_DEFAULT_APP_ENABLE_STATISTICS: 'true'
      SOKETI_DEFAULT_APP_MAX_CONNECTIONS: '10000'
      SOKETI_DEFAULT_APP_MAX_BACKEND_EVENTS_PER_SECOND: '100'
      SOKETI_DEFAULT_APP_MAX_CLIENT_EVENTS_PER_SECOND: '100'
      SOKETI_DEFAULT_APP_MAX_READ_REQUEST_PER_SECOND: '100'
    networks:
      - opbx
    healthcheck:
      test: ['CMD', 'wget', '-q', '-O', '-', 'http://localhost:9601/ready']
      interval: 10s
      timeout: 5s
      retries: 3
    restart: unless-stopped

  # AMD Worker - Java/Vert.x 5 voicemail detection service
  # Receives audio streams from Cloudonix via nginx WebSocket proxy at /ws/amd/
  # Logs detection results locally (OPBX HTTP callbacks planned for Phase 4)
  amd-worker:
    build:
      context: ./amd-worker
      dockerfile: Dockerfile
    container_name: opbx_amd_worker
    labels:
      - "logging.opbx/collect=true"
    restart: unless-stopped
    # No external ports - all traffic proxied through nginx
    environment:
      - AMD_WEBSOCKET_PORT=8082
      - AMD_HTTP_PORT=8083
      - AMD_WORKER_API_TOKEN=${AMD_WORKER_API_TOKEN:-dev-amd-token-change-in-production}
      - AMD_MODEL_PATH=/app/models/beep_detector.onnx
      - AMD_MAX_CONCURRENT_STREAMS=${AMD_MAX_CONCURRENT_STREAMS:-100}
      - AMD_LOG_LEVEL=info
      - AMD_DUMP_AUDIO=${AMD_DUMP_AUDIO:-false}
      - AMD_DUMP_AUDIO_PATH=${AMD_DUMP_AUDIO_PATH:-/tmp/amd-dumps}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
    volumes:
      - ./amd-worker/models:/app/models:ro
      - ./volumes/amd-dumps:/tmp/amd-dumps
    depends_on:
      - nginx
      - redis
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8083/health >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    networks:
      - opbx

  # Auto Dialer Worker - Go-based service for outbound campaigns
  # Receives CDR events from Laravel via webhook at /webhooks/cdr
  acd-worker:
    build:
      context: ./acd-worker
      dockerfile: Dockerfile
    container_name: opbx_acd_worker
    labels:
      - "logging.opbx/collect=true"
    restart: unless-stopped
    # No external ports - reached by Laravel over the internal Docker network
    environment:
      - ACD_HTTP_PORT=8084
      - ACD_HEALTH_PORT=8085
      - ACD_WORKER_API_TOKEN=${ACD_WORKER_API_TOKEN:-dev-acd-token-change-in-production}
      - ACD_LOG_LEVEL=info
      - ACD_REDIS_HOST=redis
      - ACD_REDIS_PORT=6379
      - ACD_REDIS_PASSWORD=${REDIS_PASSWORD}
    depends_on:
      - redis
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8085/health >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    networks:
      - opbx

  # Auto Dialer Worker - Go-based service for outbound campaigns
  # Receives CDR events from Laravel via webhook at /webhooks/cdr
  dialer-worker:
    build:
      context: ./dialer-worker
      dockerfile: Dockerfile
    container_name: opbx_dialer_worker
    labels:
      - "logging.opbx/collect=true"
    environment:
      - WORKER_ID=${DIALER_WORKER_ID:-worker-1}
      - LARAVEL_API_URL=${DIALER_LARAVEL_API_URL:-http://nginx}
      - LARAVEL_API_TOKEN=${DIALER_WORKER_API_TOKEN:-dev-token-change-in-production}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD}
      - REDIS_DB=0
      - POLL_INTERVAL=${DIALER_POLL_INTERVAL:-10s}
      - HEALTH_CHECK_PORT=${DIALER_HEALTH_PORT:-8080}
      - WEBHOOK_PORT=${DIALER_WEBHOOK_PORT:-8081}
      - WEBHOOK_SECRET=${DIALER_WEBHOOK_SECRET:-}
    ports:
      # Host-side port is separate from the container's WEBHOOK_PORT (8081)
      # because dev machines often have other services on 8081.
      - "${DIALER_WEBHOOK_HOST_PORT:-8181}:8081"  # Webhook endpoint for CDR
    networks:
      - opbx
    depends_on:
      - app
      - nginx
      - redis
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8081/webhooks/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

  # ngrok - Secure tunneling for webhook development
  # Provides a public URL for Cloudonix webhooks
  # Docs: https://ngrok.com/docs
  ngrok:
    image: ngrok/ngrok:3-alpine
    container_name: opbx_ngrok
    # Use a shell command to conditionally add --url when NGROK_DOMAIN is set
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        if [ -n "${NGROK_DOMAIN}" ]; then
          exec ngrok http nginx:80 --url=${NGROK_DOMAIN} --config /etc/ngrok.yml
        else
          exec ngrok http nginx:80 --config /etc/ngrok.yml
        fi
    environment:
      NGROK_AUTHTOKEN: ${NGROK_AUTHTOKEN}
      NGROK_DOMAIN: ${NGROK_DOMAIN:-}
    volumes:
      - ./docker/ngrok/ngrok.yml:/etc/ngrok.yml:ro
    depends_on:
      - nginx
    networks:
      - opbx
    ports:
      - "4040:4040"  # ngrok web interface
    restart: unless-stopped
    # Note: Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
    # Set NGROK_AUTHTOKEN in .env
    # Optional: Set NGROK_DOMAIN to use a custom domain (e.g., opbx.ngrok.io)
    # Public URL will be shown in logs: docker compose logs ngrok

  # OPBX MCP Server - semantic MCP facade over the OPBX REST API
  # MCP clients connect to http://localhost:${MCP_PORT}/mcp with their OPBX
  # personal access token or opbxk_ API key as the Bearer credential.
  mcp-server:
    build:
      context: ./mcp-server
      dockerfile: Dockerfile
    container_name: opbx_mcp
    ports:
      - "${MCP_PORT:-8080}:8080"
    environment:
      NODE_ENV: production
      OPBX_BASE_URL: http://nginx
      LOG_LEVEL: ${MCP_LOG_LEVEL:-info}
      OTEL_EXPORTER_OTLP_ENDPOINT: ${OTEL_EXPORTER_OTLP_ENDPOINT:-}
    depends_on:
      - nginx
    networks:
      - opbx
    healthcheck:
      # Use 127.0.0.1, not localhost: in the alpine container `localhost` resolves
      # to ::1 (IPv6) but the Fastify server listens on 0.0.0.0 (IPv4-only), so a
      # localhost probe gets connection refused and marks the container unhealthy.
      test: ['CMD', 'wget', '-q', '-O', '-', 'http://127.0.0.1:8080/health']
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: unless-stopped

  # ── Log aggregation stack (optional, profile "logs") ──────────────────
  # Enable with: docker compose --profile logs up -d
  # Grafana UI is proxied by nginx at /logs/. See docs/LOG-AGGREGATION.md.
  loki:
    image: grafana/loki:3.4.2
    container_name: opbx_loki
    profiles: ["logs"]
    command: -config.file=/etc/loki/loki-config.yml -config.expand-env=true
    volumes:
      - ./docker/loki/loki-config.yml:/etc/loki/loki-config.yml:ro
      - loki_data:/loki
    environment:
      - LOKI_RETENTION_HOURS=${LOKI_RETENTION_HOURS:-168}
    healthcheck:
      test: ['CMD', 'wget', '-q', '-O', '-', 'http://localhost:3100/ready']
      interval: 10s
      timeout: 5s
      retries: 12
    networks:
      - opbx
    restart: unless-stopped

  alloy:
    image: grafana/alloy:v1.8.3
    container_name: opbx_alloy
    # Root required to read container logs via the Docker socket.
    user: root
    # Rootless Podman (SELinux) blocks socket access without this; harmless
    # on Docker.
    security_opt:
      - label=disable
    profiles: ["logs"]
    command: run --server.http.listen-addr=0.0.0.0:12345 --storage.path=/var/lib/alloy /etc/alloy/config.alloy
    volumes:
      - ./docker/alloy/config.alloy:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    depends_on:
      loki:
        condition: service_started
    # No healthcheck: the alloy image is distroless (no wget/curl/shell).
    networks:
      - opbx
    restart: unless-stopped

  grafana:
    image: grafana/grafana:11.6.0
    container_name: opbx_grafana
    profiles: ["logs"]
    volumes:
      - ./docker/grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana_data:/var/lib/grafana
    environment:
      # Grafana 301s any request whose Host does not match root_url's domain.
      # OPBX is reached via varying hosts (localhost, ngrok, custom domains),
      # so the nginx /logs/ block pins Host to "localhost" and root_url
      # matches it. Grafana only generates relative URLs beyond that.
      - GF_SERVER_ROOT_URL=http://localhost/logs/
      - GF_SERVER_SERVE_FROM_SUB_PATH=true
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
      - GF_AUTH_ANONYMOUS_ENABLED=false
      - GF_AUTH_DISABLE_LOGIN_FORM=false
    depends_on:
      loki:
        condition: service_healthy
    healthcheck:
      test: ['CMD', 'wget', '-q', '-O', '-', 'http://localhost:3000/api/health']
      interval: 10s
      timeout: 5s
      retries: 12
    networks:
      - opbx
    restart: unless-stopped

volumes:
  loki_data:
  grafana_data:

networks:
  opbx:
    driver: bridge
