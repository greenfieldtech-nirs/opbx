{
  "name": "opbx-frontend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:embed": "vite build --config vite.embed.config.ts && mkdir -p ../public/embed/assets && cp dist-embed/embed-widget.js dist-embed/embed-widget.css ../public/embed/assets/",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
