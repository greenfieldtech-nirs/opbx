# ═══════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════
APP_NAME="OPBX - Open Source Business PBX"
APP_ENV=production
APP_KEY=                             # Generate: php artisan generate:password
APP_DEBUG=false
APP_URL=https://your-domain.com

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ═══════════════════════════════════════════════════════════
# DATABASE (MySQL - default for production)
# ═══════════════════════════════════════════════════════════
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=opbx
DB_USERNAME=opbx
DB_PASSWORD=                        # Generate: openssl rand -base64 32
DB_ROOT_PASSWORD=                   # Generate: openssl rand -base64 32

# ═══════════════════════════════════════════════════════════
# SESSION
# ═══════════════════════════════════════════════════════════
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ═══════════════════════════════════════════════════════════
# LARAVEL SANCTUM
# ═══════════════════════════════════════════════════════════
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SANCTUM_EXPIRATION=1440

# ═══════════════════════════════════════════════════════════
# BROADCASTING / WEBSOCKETS (Soketi)
# ═══════════════════════════════════════════════════════════
BROADCAST_DRIVER=pusher
BROADCAST_CONNECTION=default

PUSHER_APP_ID=app-id
PUSHER_APP_KEY=pbxappkey
PUSHER_APP_SECRET=                   # Generate: openssl rand -base64 64
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# ═══════════════════════════════════════════════════════════
# FILESYSTEM
# ═══════════════════════════════════════════════════════════
FILESYSTEM_DISK=local

# ═══════════════════════════════════════════════════════════
# QUEUE
# ═══════════════════════════════════════════════════════════
QUEUE_CONNECTION=redis

# ═══════════════════════════════════════════════════════════
# CACHE
# ═══════════════════════════════════════════════════════════
CACHE_STORE=redis

# ═══════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=                      # Generate: openssl rand -base64 32
REDIS_PORT=6379

# ═══════════════════════════════════════════════════════════
# MAIL (optional)
# ═══════════════════════════════════════════════════════════
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ═══════════════════════════════════════════════════════════
# CLOUDONIX CPAAS
# ═══════════════════════════════════════════════════════════
# API base URL (get your API token from https://developers.cloudonix.com)
# API credentials are configured per-organization in Settings → Cloudonix
CLOUDONIX_API_BASE_URL=https://api.cloudonix.io
CLOUDONIX_API_TIMEOUT=30

# SIP server for extensions (default: sip.cloudonix.io)
CLOUDONIX_SIP_SERVER=sip.cloudonix.io

# ═══════════════════════════════════════════════════════════
# WEBHOOK CONFIGURATION
# ═══════════════════════════════════════════════════════════
# Public URL where Cloudonix can reach your webhooks
# For local development, use ngrok (tunnel service runs in Docker)
WEBHOOK_BASE_URL=https://your-domain.com

# Rate limiting (requests per minute)
RATE_LIMIT_API=60
RATE_LIMIT_WEBHOOKS=100
RATE_LIMIT_VOICE=1000
RATE_LIMIT_SENSITIVE=10
RATE_LIMIT_AUTH=5

# ═══════════════════════════════════════════════════════════
# CIRCUIT BREAKER
# ═══════════════════════════════════════════════════════════
# Circuit breaker prevents cascading failures from Cloudonix API
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_CLOUDONIX_THRESHOLD=5
CIRCUIT_BREAKER_CLOUDONIX_TIMEOUT=30
CIRCUIT_BREAKER_CLOUDONIX_RETRY_AFTER=60

# ═══════════════════════════════════════════════════════════
# CALL STATE CONFIGURATION
# ═══════════════════════════════════════════════════════════
CALL_LOCK_TIMEOUT=30
CALL_STATE_TTL=3600

# ═══════════════════════════════════════════════════════════
# CXML CONFIGURATION
# ═══════════════════════════════════════════════════════════
CXML_DEFAULT_TIMEOUT=30
CXML_DEFAULT_VOICE=en-US-Standard-A

# ═══════════════════════════════════════════════════════════
# FRONTEND
# ═══════════════════════════════════════════════════════════
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════
# FRONTEND ENVIRONMENT VARIABLES (Vite/React)
# ═══════════════════════════════════════════════════════════
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=/api/v1
VITE_WEBSOCKET_HOST=nginx
VITE_WEBSOCKET_PORT=80
VITE_WEBSOCKET_KEY=pbxappkey
VITE_WEBSOCKET_CLUSTER=mt1

# ═══════════════════════════════════════════════════════════
# MINIO / S3 STORAGE
# ═══════════════════════════════════════════════════════════
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=recordings
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_PATH_STYLE=true

# ═══════════════════════════════════════════════════════════
# NGROK (optional - for local webhook development)
# ═══════════════════════════════════════════════════════════
# Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=

# ═══════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
