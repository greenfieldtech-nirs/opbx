# ═══════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════
APP_NAME="OPBX - Open Source Business PBX"
APP_ENV=production
APP_KEY=                             # Generate: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com

# Nginx port mapping (host port that nginx container binds to)
# Change if you need nginx to listen on a different port
APP_PORT=80

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ═══════════════════════════════════════════════════════════
# APPLICATION MODE (SaaS Deployment)
# ═══════════════════════════════════════════════════════════
# Mode: development (default) or production (SaaS mode)
# - development: Each organization configures their own webhook URLs
# - production: Webhook URL is set at application level for all organizations
OPBX_APPLICATION_MODE=development

# Application-level webhook base URL (required in production mode)
# When set, this overrides all organization-specific webhook URLs
# Example: https://saas.opbx.com
# OPBX_APPLICATION_WEBHOOK_BASEURL=

# ═══════════════════════════════════════════════════════════
# DATABASE (MySQL - default for production)
# ═══════════════════════════════════════════════════════════
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=opbx
DB_USERNAME=opbx
DB_PASSWORD=                        # Generate: openssl rand -base64 32
DB_ROOT_PASSWORD=                   # Generate: openssl rand -base64 32

# Set to expose MySQL port to host (development only, leave empty for production)
# DB_EXPOSE_PORT=3306

# ═══════════════════════════════════════════════════════════
# SESSION
# ═══════════════════════════════════════════════════════════
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ═══════════════════════════════════════════════════════════
# LARAVEL SANCTUM
# ═══════════════════════════════════════════════════════════
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SANCTUM_EXPIRATION=1440

# ═══════════════════════════════════════════════════════════
# BROADCASTING / WEBSOCKETS (Soketi)
# ═══════════════════════════════════════════════════════════
BROADCAST_DRIVER=pusher
BROADCAST_CONNECTION=pusher

PUSHER_APP_ID=app-id
PUSHER_APP_KEY=pbxappkey
PUSHER_APP_SECRET=                   # Generate: openssl rand -base64 64
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# Soketi server ports (for Docker port mapping)
# SOKETI_PORT=6001
# SOKETI_METRICS_PORT=9601

# Soketi debug mode (set to 1 for verbose logging)
# SOKETI_DEBUG=0

# ═══════════════════════════════════════════════════════════
# FILESYSTEM
# ═══════════════════════════════════════════════════════════
FILESYSTEM_DISK=local

# ═══════════════════════════════════════════════════════════
# QUEUE
# ═══════════════════════════════════════════════════════════
QUEUE_CONNECTION=redis

# ═══════════════════════════════════════════════════════════
# CACHE
# ═══════════════════════════════════════════════════════════
CACHE_STORE=redis

# ═══════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=                      # Generate: openssl rand -base64 32
REDIS_PORT=6379

# Set to expose Redis port to host (development only, leave empty for production)
# REDIS_EXPOSE_PORT=6379

# ═══════════════════════════════════════════════════════════
# MAIL (optional)
# ═══════════════════════════════════════════════════════════
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ═══════════════════════════════════════════════════════════
# CLOUDONIX CPAAS
# ═══════════════════════════════════════════════════════════
# API base URL (get your API token from https://developers.cloudonix.com)
# API credentials are configured per-organization in Settings → Cloudonix
CLOUDONIX_API_BASE_URL=https://api.cloudonix.io
CLOUDONIX_API_TIMEOUT=30

# SIP server for extensions (default: sip.cloudonix.io)
CLOUDONIX_SIP_SERVER=sip.cloudonix.io

# ═══════════════════════════════════════════════════════════
# WEBHOOK CONFIGURATION
# ═══════════════════════════════════════════════════════════
# Rate limiting (requests per minute)
RATE_LIMIT_API=60
RATE_LIMIT_WEBHOOKS=100
RATE_LIMIT_VOICE=1000
RATE_LIMIT_SENSITIVE=10
RATE_LIMIT_SENSITIVE_ADMIN=60
RATE_LIMIT_AUTH=5

# Optional CDR webhook authentication key
# When set, CDR webhooks must include this key in X-CDR-Auth-Key header or Bearer token
# Leave empty to disable (domain UUID verification only)
# CLOUDONIX_CDR_AUTH_KEY=

# ═══════════════════════════════════════════════════════════
# CIRCUIT BREAKER
# ═══════════════════════════════════════════════════════════
# Circuit breaker prevents cascading failures from Cloudonix API
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_CLOUDONIX_THRESHOLD=5
CIRCUIT_BREAKER_CLOUDONIX_TIMEOUT=30
CIRCUIT_BREAKER_CLOUDONIX_RETRY_AFTER=60

# ═══════════════════════════════════════════════════════════
# VOICE ROUTING CONFIGURATION
# ═══════════════════════════════════════════════════════════
# Cache TTLs (in seconds)
VOICE_CACHE_EXTENSION_TTL=1800
VOICE_CACHE_BUSINESS_HOURS_TTL=900

# Lock settings
VOICE_LOCK_TIMEOUT=30
VOICE_LOCK_BLOCK=3

# Retry settings
VOICE_MAX_RETRIES=3

# Idempotency TTL (in seconds)
VOICE_IDEMPOTENCY_TTL=3600

# Call settings
VOICE_NO_ANSWER_TIMEOUT=30

# ═══════════════════════════════════════════════════════════
# CXML CONFIGURATION
# ═══════════════════════════════════════════════════════════
CXML_DEFAULT_TIMEOUT=30

# ═══════════════════════════════════════════════════════════
# FRONTEND
# ═══════════════════════════════════════════════════════════
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════
# FRONTEND ENVIRONMENT VARIABLES (Vite/React)
# ═══════════════════════════════════════════════════════════
# IMPORTANT: When using nginx reverse proxy, WebSocket connections must go 
# through port 80/443 instead of directly to localhost:6001
#
# DEVELOPMENT: Use localhost for direct container access
# VITE_WS_HOST=localhost
# VITE_WS_PORT=6001
# VITE_WS_SCHEME=http
# VITE_WS_URL=ws://localhost:6001
# VITE_WEBSOCKET_HOST=localhost
# VITE_WEBSOCKET_PORT=6001
#
# PRODUCTION (with nginx reverse proxy): Use your public domain
# VITE_WS_HOST=your-domain.com
# VITE_WS_PORT=80
# VITE_WS_SCHEME=http
# VITE_WS_URL=ws://your-domain.com
# VITE_WEBSOCKET_HOST=your-domain.com
# VITE_WEBSOCKET_PORT=80

VITE_API_BASE_URL=/api/v1

# WebSocket Configuration
# Laravel Echo/Pusher compatible settings
VITE_WS_HOST=localhost
VITE_WS_PORT=6001
VITE_WS_SCHEME=http

# Allowed hosts for Vite development server (comma-separated)
VITE_ALLOWED_HOSTS=localhost,.localhost

# ═══════════════════════════════════════════════════════════
# MINIO / S3 STORAGE
# ═══════════════════════════════════════════════════════════
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=recordings
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_PATH_STYLE=true

# Set to expose MinIO ports to host (development only, leave empty for production)
# MINIO_EXPOSE_PORT=9000
# MINIO_CONSOLE_EXPOSE_PORT=9001

# ═══════════════════════════════════════════════════════════
# NGROK (optional - for local webhook development)
# ═══════════════════════════════════════════════════════════
# Ngrok provides secure tunneling for Cloudonix webhooks.
# Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
#
# NGROK_AUTHTOKEN=your-authtoken-here
#
# Optional: Use a custom ngrok domain (requires ngrok paid plan)
# When set, ngrok will use this domain instead of a random subdomain
# Example: NGROK_DOMAIN=opbx.ngrok.io
# NGROK_DOMAIN=

# ═══════════════════════════════════════════════════════════
# AUTO DIALER WORKER CONFIGURATION (v2.0)
# ═══════════════════════════════════════════════════════════
# These settings configure the Go-based auto dialer worker.
# The worker executes outbound call campaigns via Cloudonix.

# Worker ID (unique identifier for this worker instance)
DIALER_WORKER_ID=worker-1

# Laravel API Configuration
DIALER_LARAVEL_API_URL=http://nginx
DIALER_WORKER_API_TOKEN=dev-token-change-in-production

# Webhook Configuration (worker receives CDR events from Laravel)
DIALER_WEBHOOK_PORT=8081
DIALER_WEBHOOK_SECRET=          # Generate: openssl rand -hex 32

# Polling Interval (how often to check for new campaigns)
DIALER_POLL_INTERVAL=10s

# ═══════════════════════════════════════════════════════════
# AUTO DIALER HORIZONTAL SCALING
# ═══════════════════════════════════════════════════════════
# Multiple workers can run concurrently for higher call volume.
# Scale with: docker compose up -d --scale dialer-worker=3
#
# Each worker will:
# 1. Poll Laravel for active campaigns
# 2. Use Redis for distributed locking and state management
# 3. Receive CDR events via webhook from Laravel

# ═══════════════════════════════════════════════════════════
# AMD WORKER CONFIGURATION
# ═══════════════════════════════════════════════════════════
# These settings configure the Java/Vert.x stream-based voicemail detection worker.
# The worker receives audio streams from Cloudonix and detects voicemail beeps.

# Shared secret for AMD worker <-> OPBX authentication
AMD_WORKER_API_TOKEN=dev-amd-token-change-in-production

# Maximum concurrent audio streams per AMD worker container (default: 100)
AMD_MAX_CONCURRENT_STREAMS=100

# DEBUG: Dump received audio streams to WAV files for offline analysis
# Set to true to enable. Files are written as 16kHz mono PCM16 WAV.
AMD_DUMP_AUDIO=false
AMD_DUMP_AUDIO_PATH=/tmp/amd-dumps

# ═══════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════
# USERCHECK EMAIL VALIDATION SERVICE
# ═══════════════════════════════════════════════════════════
# UserCheck.com API for validating email addresses during registration
# Get your API token from: https://app.usercheck.com
#
# IMPORTANT: This is a BLOCKING validation. If UserCheck API is unavailable,
# registration will be BLOCKED for security reasons.
#
USERCHECK_ENABLED=true
USERCHECK_API_TOKEN=
USERCHECK_BASE_URL=https://api.usercheck.com
USERCHECK_TIMEOUT=5

# Validation Rules - Set to false to allow specific email types
# All default to true (strict validation) for security
USERCHECK_BLOCK_DISPOSABLE=true
USERCHECK_BLOCK_BLOCKLISTED=true
USERCHECK_BLOCK_SPAM=true
USERCHECK_BLOCK_ROLE_ACCOUNTS=true
USERCHECK_BLOCK_RELAY_DOMAINS=false
USERCHECK_BLOCK_PUBLIC_DOMAINS=false

# ═══════════════════════════════════════════════════════════
# GOOGLE RECAPTCHA v3
# ═══════════════════════════════════════════════════════════
# Get your site key and secret key from: https://www.google.com/recaptcha/admin
# Use reCAPTCHA v3 (invisible - no checkbox required)
#
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ═══════════════════════════════════════════════════════════
# TRANSACTIONAL EMAIL CONFIGURATION
# ═══════════════════════════════════════════════════════════
# IMPORTANT: Only ONE provider can be enabled at a time!
# Set the provider you want to use:
EMAIL_PROVIDER=mailgun

EMAIL_QUEUE=default
EMAIL_TRACK_OPENS=true
EMAIL_TRACK_CLICKS=true

# Mailgun (set ENABLED=true to use)
# Get your API key from: https://app.mailgun.com/settings/api_security
MAILGUN_ENABLED=false
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAILGUN_REGION=us

# Mailjet (set ENABLED=true to use)
# Get your API key from: https://app.mailjet.com/account/api_keys
MAILJET_ENABLED=false
MAILJET_APIKEY=
MAILJET_APISECRET=

# MailerLite (set ENABLED=true to use)
# Note: MailerLite has limited transactional email support
# Get your API key from: https://dashboard.mailerlite.com/integrations/api
MAILERLITE_ENABLED=false
MAILERLITE_API_KEY=

# SendInBlue/Brevo (set ENABLED=true to use)
# Get your API key from: https://app.brevo.com/settings/keys/api
SENDINBLUE_ENABLED=false
SENDINBLUE_API_KEY=

# ═══════════════════════════════════════════════════════════
# AUTH0 SYNDICATED AUTH (SaaS Mode)
# ═══════════════════════════════════════════════════════════
# Feature flag - must be true for Auth0 social login/signup to appear
OPBX_SAAS_ENABLED=false

# Auth0 tenant credentials (only used when OPBX_SAAS_ENABLED=true)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=https://app.opbx.com/ui/auth/callback
AUTH0_PROVIDERS=google,facebook,microsoft,github,x

# ═══════════════════════════════════════════════════════════
# USER INVITATIONS
# ═══════════════════════════════════════════════════════════
OPBX_INVITE_TOKEN_TTL_HOURS=24
OPBX_INVITE_RATE_LIMIT_PER_HOUR=10


# ═══════════════════════════════════════════════════════════
# EMBEDDED DIALER
# ═══════════════════════════════════════════════════════════
# Standalone widget bundle + stylesheet loaded inside the dialer iframe.
# EMBED_WIDGET_URL=/embed/assets/embed-widget.js
# EMBED_WIDGET_CSS_URL=/embed/assets/embed-widget.css
#
# Allow http:// framing of the dialer iframe. LOCAL DEV ONLY — lets an
# http://localhost demo page embed the dialer. NEVER enable in production;
# it exposes the embedded extension's SIP credentials to insecure origins.
EMBED_ALLOW_INSECURE_FRAMING=false
#
# NOTE: the per-user "allowed domains" allowlist is NOT configured here. It is
# application data on each user's embed token (user_embed_tokens.allowed_domains),
# managed via the UI (Users → Embed → Allowed Domains) or the embed-token API.
