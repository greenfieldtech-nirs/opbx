# Git
.git
.gitignore
.gitattributes

# Docker
.dockerignore
docker-compose.yml
docker-compose.yml.bak-*
.compose-update.*
Dockerfile*

# Runtime data and backups (bind-mounted at run time; never bake MySQL data, object storage or dumps into an image)
volumes/
backups/

# Agent workspace
.my_agent/

# Documentation
*.md
docs/

# IDE
.idea
.vscode
*.swp
*.swo
*~

# Node modules (frontend)
frontend/node_modules
frontend/dist
frontend/.env
frontend/.env.local

# Laravel
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log

# Storage (will be created by container)
storage/*.key
storage/app/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*

# Keep storage structure
!storage/app/.gitignore
!storage/app/public/.gitignore
!storage/framework/.gitignore
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore
!storage/logs/.gitignore

# Testing
tests/
phpunit.xml

# Package managers and build output
vendor/
node_modules/
**/node_modules
**/target

# OS
.DS_Store
Thumbs.db
