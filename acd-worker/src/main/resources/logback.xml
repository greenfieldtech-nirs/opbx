<configuration>
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Flat contract shared with the rest of the stack. -->
            <customFields>{"service":"acd-worker","log_type":"call_flow"}</customFields>
            <includeMdcKeyName>session_token</includeMdcKeyName>
            <includeMdcKeyName>call_id</includeMdcKeyName>
            <includeMdcKeyName>org_id</includeMdcKeyName>
            <includeMdcKeyName>queue_id</includeMdcKeyName>
            <fieldNames>
                <timestamp>ts</timestamp>
                <message>msg</message>
                <levelValue>[ignore]</levelValue>
                <thread>[ignore]</thread>
                <logger>[ignore]</logger>
                <version>[ignore]</version>
            </fieldNames>
            <timeZone>UTC</timeZone>
        </encoder>
    </appender>
    <root level="${ACD_LOG_LEVEL:-info}">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
